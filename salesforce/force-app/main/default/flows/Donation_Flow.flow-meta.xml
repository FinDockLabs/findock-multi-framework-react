    <formulas>
        <description>The final amount taking into account the cover fees checkbox</description>
        <name>FinalAmountOneTime</name>
        <dataType>Number</dataType>
        <expression>IF({!CoverFees}, VALUE({!amountAndFrequency.amountOneTime}) + 0.50, VALUE({!amountAndFrequency.amountOneTime}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>The final amount taking into account the cover fees checkbox</description>
        <name>FinalAmountRecurring</name>
        <dataType>Number</dataType>
        <expression>IF({!CoverFees}, VALUE({!amountAndFrequency.amountRecurring}) + 0.50, VALUE({!amountAndFrequency.amountRecurring}))</expression>
        <scale>2</scale>
    </formulas>
