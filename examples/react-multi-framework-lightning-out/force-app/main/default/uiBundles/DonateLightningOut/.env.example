# Copy to .env and fill in. See README.md.
# Your org's My Domain. The build downloads the Lightning Out runtime from here.
VITE_SALESFORCE_MY_DOMAIN=https://MY-DOMAIN.my.salesforce.com
# Id of the Lightning Out 2.0 app (Setup > Lightning Out 2.0 Apps), starts with 1Us.
VITE_LIGHTNING_OUT_APP_ID=
# URL prefix of the Lightning Out site in the same org.
VITE_LIGHTNING_OUT_SITE_PREFIX=lightningout
