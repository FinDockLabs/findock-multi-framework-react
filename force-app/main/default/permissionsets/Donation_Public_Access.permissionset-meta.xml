<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Donation Public Access</label>
    <description>Least-privilege access for the donation site guest user: execute the donation REST wrapper classes only, no object CRUD. Assign together with the FinDock Payer permission set group.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses><apexClass>DonationPaymentResource</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>DonationPaymentService</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>DonationSettings</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>FinDockGateway</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>FinDockGatewayResponse</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>FinDockRestContextGateway</apexClass><enabled>true</enabled></classAccesses>
</PermissionSet>
